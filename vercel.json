{
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{frontend/**,backend/**,supabase/**,.git/**,**/*.md,**/*.sql}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|assets/|.*\\.(?:jpg|jpeg|gif|png|svg|ico|css|js|woff|woff2|webp|json)$).*)",
      "destination": "/index.html"
    }
  ]
}
